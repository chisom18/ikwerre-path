{
  "name": "ikwerre-path",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:all": "concurrently -k \"npm:server\" \"npm:dev\"",
    "start": "node --env-file-if-exists=.env server/index.js",
    "admin:setup": "node --env-file-if-exists=.env server/create-admin.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 tests/api.test.js tests/lessonContent.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "vite": "^7.0.0"
  }
}
